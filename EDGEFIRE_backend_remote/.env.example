# Copy to .env. Run scripts/init_env.py for fresh secret keys.
DATABASE_URL=postgresql+psycopg://edgefire:edgefire_local@127.0.0.1:5433/edgefire
POSTGRES_PASSWORD=edgefire_local
REDIS_URL=redis://127.0.0.1:6380/0
STORAGE_ROOT=./runtime
# These must be independent random secrets, >= 24 characters.
LOCAL_API_TOKEN=REPLACE_ME
HARDWARE_API_TOKEN=REPLACE_ME
WORKER_API_TOKEN=REPLACE_ME
WS_SIGNING_KEY=REPLACE_ME
# Private tailnet IPv4 (100.x.y.z); local testing can use 127.0.0.1.
BIND_HOST=127.0.0.1
PORT=8200
ALLOWED_ORIGINS=http://127.0.0.1:3200,http://localhost:3200,http://127.0.0.1:3000,http://localhost:3000
# Set to AI PC private address after it starts adapters/ai_aux.py.
AI_AUX_URL=
AI_AUX_TOKEN=REPLACE_ME
# Optional research-only threshold rules; leave disabled until calibrated.
# Example synthetic-only rule: {"demo":{"gas_data.CO":[10,20,40,80]}}
RISK_RULES_JSON={}
